DOMAIN=hisaab.example.com
SUPPORT_EMAIL=support@hisaab.example.com
# Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_POOL_SIZE=10

# Twilio Verify: create a Verify Service, then add these server-only values.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
