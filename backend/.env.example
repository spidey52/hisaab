# PostgreSQL 18 — use your own instance (recommended for local dev)
# Example Docker one-off: docker run -d --name hisaab-pg -e POSTGRES_PASSWORD=hisaab -e POSTGRES_USER=hisaab -e POSTGRES_DB=hisaab -p 5432:5432 postgres:18-alpine
DATABASE_URL=postgresql://hisaab:hisaab@127.0.0.1:5432/hisaab

# Optional pool tuning. Add SSL options to DATABASE_URL when your provider needs them.
# DATABASE_POOL_SIZE=10
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_CONNECT_TIMEOUT_MS=5000

NODE_ENV=development
PORT=3001
SESSION_SECRET=local-only-hisaab-session-secret-change-for-production

# Local development only: returns the OTP in the request-otp response and logs it.
# Must be false in production.
OTP_IN_RESPONSE=true

# OTP delivery channel: "console" (log only, local dev) or "notify" (SMS via notify service).
OTP_DELIVERY=console
# Notify service (office/whatsapp-sender, deployed at notify.mgdh.in) used when OTP_DELIVERY=notify.
OTP_NOTIFY_BASE_URL=https://notify.mgdh.in
OTP_NOTIFY_SERVICE=hisaab
OTP_NOTIFY_TIMEOUT_MS=10000

TRUST_PROXY=false
