# PostgreSQL 18 — use your own instance (recommended for local dev)
# Example Docker one-off: docker run -d --name hisaab-pg -e POSTGRES_PASSWORD=hisaab -e POSTGRES_USER=hisaab -e POSTGRES_DB=hisaab -p 5432:5432 postgres:18-alpine
DATABASE_URL=postgresql://hisaab:hisaab@127.0.0.1:5432/hisaab

# Optional pool / TLS
# DATABASE_POOL_SIZE=10
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

PORT=3001
SESSION_SECRET=local-only-hisaab-session-secret-change-for-production

# Used only for console-OTP localhost guard (not CORS — all origins allowed)
PUBLIC_BASE_URL=http://localhost:3000

OTP_PROVIDER=console
ALLOW_INSECURE_LOCAL_OTP=true
TRUST_PROXY=false

# Required when OTP_PROVIDER=twilio_verify
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
